{"stories":[{"dialog":{"questions":[{"ask":"What do you do in the morning?","ask_cn":"早上你做什么呀？","options":["I get up in the morning.","I put on my shoes."]}],"role":"sun"},"id":"story_morning","level":2,"pages":[{"text":"I get up in the morning.","text_cn":"早上我起床。","words":[{"cn":"早上","word":"morning"}]},{"text":"I put on my shoes.","text_cn":"我穿上鞋子。","words":[{"cn":"鞋子","word":"shoes"}]},{"text":"I put on my shirt.","text_cn":"我穿上衣服。","words":[{"cn":"衣服","word":"shirt"}]},{"text":"I can do it myself!","text_cn":"我自己能行！","words":[]},{"text":"I wash my hands.","text_cn":"我洗洗手。","words":[{"cn":"手","word":"hands"}]},{"text":"I brush my teeth.","text_cn":"我刷刷牙。","words":[{"cn":"牙齿","word":"teeth"}]},{"text":"I like the morning!","text_cn":"我喜欢早上！","words":[]}],"title":"I Like Morning"},{"dialog":{"questions":[{"ask":"What do you like?","ask_cn":"你喜欢什么呀？","options":["I like the little cat.","I like the big dog."]}],"role":"cat"},"id":"story_animals","level":1,"pages":[{"text":"I like the little cat.","text_cn":"我喜欢这只小猫。","words":[{"cn":"小的","word":"little"},{"cn":"猫","word":"cat"}]},{"text":"I like the big dog.","text_cn":"我喜欢这只大狗。","words":[{"cn":"大的","word":"big"},{"cn":"狗","word":"dog"}]},{"text":"The little cat is happy.","text_cn":"小猫很开心。","words":[{"cn":"开心的","word":"happy"}]},{"text":"The big dog is happy.","text_cn":"大狗很开心。","words":[]},{"text":"I like my friends!","text_cn":"我喜欢我的朋友们！","words":[{"cn":"朋友","word":"friends"}]}],"title":"I Like Animals"}]}